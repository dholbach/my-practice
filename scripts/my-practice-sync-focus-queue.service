[Unit]
Description=Materialize Focus Queue tasks (P-050)
After=network.target

[Service]
Type=oneshot
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/path/to/my-practice
ExecStart=/usr/bin/env python3 /path/to/my-practice/dev.py manage sync_focus_queue_tasks

[Install]
WantedBy=default.target
