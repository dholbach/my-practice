# Secrets
.env

# Editor/agent local state (.claude/settings.json IS tracked; the local one is not)
.claude/settings.local.json

# Project-level memory notes (instance-specific, not for public repo)
/memory/

# Personal operational docs — use gitignored copies or MY_PRACTICE_DATA_DIR for filled-in versions
docs/operations/DPIA.md
docs/operations/REINSTALL_CHECKLIST.md

# Media files MUST live outside the repo (see MY_PRACTICE_DATA_DIR in .env).
# This entry is a fallback safety net in case someone accidentally points
# MEDIA_ROOT / a volume mount back inside the repo checkout.
media/
app/media/

# Client data safety nets — deliberately unanchored so they match at any depth,
# however a stray bind mount or export ends up nested in the checkout.
# Generated invoices contain client data.
invoices/
*.pdf
backups/
backup/
*.backup
*.sql.gz

# Docker volumes (safety net: postgres_data is a named volume today, but this
# catches a bind mount pointed back into the checkout)
/postgres_data/

# Logs
*.log

# Temporary test output
/test_results.txt

# OS
.DS_Store
Thumbs.db
__pycache__/

# Test artifacts
.coverage
app/.coverage
htmlcov/

# Tailwind compiled output (generated by npm run build:css)
app/static/css/tailwind.out.css
app/node_modules/

# i18n compiled message files (generated by ./dev.py i18n compilemessages)
app/locale/**/*.mo
